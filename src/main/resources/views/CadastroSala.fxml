<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.KeyCampus.controller.SalaController"
      stylesheets="@/css/StyleCadastro.css"
      styleClass="root"
      prefWidth="460"
      prefHeight="420"
      minWidth="460"  maxWidth="460"
      minHeight="420" maxHeight="420"
      spacing="0">

    <VBox styleClass="topbar">
        <Label text="Nova Sala" fx:id="lblTitleNovaSala" styleClass="page-title"/>
        <Label text="Preencha os dados para cadastrar"   styleClass="page-sub"/>
    </VBox>

    <VBox styleClass="content" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" spacing="14">

            <VBox spacing="5">
                <Label text="Nome da sala *" styleClass="form-label"/>
                <TextField fx:id="txtNome"
                           promptText="Ex: Lab de Informática 01"
                           styleClass="form-input"
                           maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Descrição" styleClass="form-label"/>
                <TextField fx:id="txtDescricao"
                           promptText="Descrição opcional"
                           styleClass="form-input"
                           maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Status" styleClass="form-label"/>
                <ComboBox fx:id="cbStatus"
                          styleClass="form-combo"
                          maxWidth="Infinity"/>
            </VBox>

            <Button text="Salvar Sala"
                    onAction="#salvar"
                    styleClass="btn-primary"
                    maxWidth="Infinity"/>

        </VBox>
    </VBox>

</VBox>

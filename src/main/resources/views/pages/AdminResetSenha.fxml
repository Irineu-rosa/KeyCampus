<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.KeyCampus.controller.AdminResetSenhaController"
      stylesheets="@/css/StyleAuth.css"
      styleClass="root"
      prefWidth="420" minWidth="420" maxWidth="420"
      prefHeight="320" minHeight="320" maxHeight="320"
      spacing="0">

    <VBox styleClass="topbar">
        <Label text="Resetar senha"               styleClass="page-title"/>
        <Label text="O usuário criará nova senha no próximo acesso"
               styleClass="page-sub"/>
    </VBox>

    <VBox styleClass="content" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" spacing="16">

            <VBox spacing="5">
                <Label text="Usuário" styleClass="form-label"/>
                <ComboBox fx:id="cbUsuarios"
                          styleClass="form-combo"
                          maxWidth="Infinity"/>
            </VBox>

            <Region prefHeight="4"/>

            <Button text="Resetar senha"
                    onAction="#resetar"
                    styleClass="btn-danger"
                    maxWidth="Infinity"/>

        </VBox>
    </VBox>

</VBox>

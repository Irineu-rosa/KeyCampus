<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.KeyCampus.controller.MainController"
            styleClass="root"
            prefWidth="1000" prefHeight="640">

    <left>
        <VBox styleClass="sidebar" prefWidth="220">

            <VBox styleClass="sidebar-logo">
                <HBox styleClass="logo-mark" alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="logo-icon">
                        <Label text="🔑"/>
                    </StackPane>
                    <Label text="KeyCampus" styleClass="logo-text"/>
                </HBox>
            </VBox>

            <VBox styleClass="nav" VBox.vgrow="ALWAYS">
                <Label text="MENU" styleClass="nav-label"/>
                <Button text="  Dashboard" styleClass="nav-item" maxWidth="Infinity" fx:id="btnDashboard" onAction="#navegar"/>
                <Button text="  Salas"        styleClass="nav-item" maxWidth="Infinity" fx:id="btnSalas"        onAction="#navegar"/>
                <Button text="  Chaves"       styleClass="nav-item" maxWidth="Infinity" fx:id="btnChaves"       onAction="#navegar"/>
                <Button text="  Usuários"     styleClass="nav-item" maxWidth="Infinity" fx:id="btnUsuarios"     onAction="#navegar"/>
                <Button text="  Agendamentos" styleClass="nav-item" maxWidth="Infinity" fx:id="btnAgendamentos" onAction="#navegar"/>
                <Button text="  Retirada"     styleClass="nav-item" maxWidth="Infinity" fx:id="btnRetirar"      onAction="#navegar"/>
            </VBox>

            <VBox styleClass="sidebar-footer">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="avatar">
                        <Label text="IR" styleClass="avatar-text"/>
                    </StackPane>
                    <VBox>
                        <Label text="Irineu"         styleClass="user-name"/>
                        <Label text="Administrador" styleClass="user-role"/>
                    </VBox>
                </HBox>
            </VBox>

        </VBox>
    </left>

    <!-- Área central: aqui as páginas são injetadas -->
    <center>
        <StackPane fx:id="contentArea"
                   alignment="TOP_LEFT"
                   style="-fx-pref-width: Infinity; -fx-pref-height: Infinity;"/>
    </center>

</BorderPane>
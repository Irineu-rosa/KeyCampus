<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>

<VBox
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.KeyCampus.controller.DashboardController"
        styleClass="main">

            <HBox styleClass="topbar" alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Dashboard"                      styleClass="page-title"/>
                    <Label fx:id="lblData" styleClass="page-sub"/>
                </VBox>
            </HBox>

            <VBox styleClass="content" VBox.vgrow="ALWAYS">

                <HBox spacing="12" styleClass="stats-grid">

                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <StackPane styleClass="stat-icon, si-blue">
                            <Label text="🚪"/>
                        </StackPane>
                        <Label fx:id="lblTotalSalas" styleClass="stat-val"/>
                        <Label text="Total de salas" styleClass="stat-lbl"/>
                    </VBox>

                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <StackPane styleClass="stat-icon, si-green">
                            <Label text="✓"/>
                        </StackPane>
                        <Label fx:id="lblSalasLivres" styleClass="stat-val"/>
                        <Label text="Salas livres" styleClass="stat-lbl"/>
                    </VBox>

                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <StackPane styleClass="stat-icon, si-coral">
                            <Label text="⏱"/>
                        </StackPane>
                        <Label fx:id="lblSalasEmUso"          styleClass="stat-val"/>
                        <Label text="Em uso agora" styleClass="stat-lbl"/>
                    </VBox>

                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <StackPane styleClass="stat-icon, si-amber">
                            <Label text="🔑"/>
                        </StackPane>
                        <Label fx:id="lblChavesAtivas"         styleClass="stat-val"/>
                        <Label text="Chaves ativas" styleClass="stat-lbl"/>
                    </VBox>

                </HBox>

                <HBox spacing="16" VBox.vgrow="ALWAYS">

                    <VBox styleClass="card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Status das salas" styleClass="card-title" HBox.hgrow="ALWAYS"/>
                            <Button text="+ Nova Sala" style="magin: 10px" onAction="#abrirCadastroSala" styleClass="card-action"/>
                        </HBox>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                    styleClass="room-scroll"
                                    maxHeight="1.7976931348623157E308">
                            <VBox fx:id="listaSalas" styleClass="room-list" spacing="8">
                            </VBox>
                        </ScrollPane>
                    </VBox>

                    <VBox styleClass="card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Próximos agendamentos" styleClass="card-title" HBox.hgrow="ALWAYS"/>
                            <Label text="Novo +"               styleClass="card-action"/>
                        </HBox>

                        <VBox fx:id="listaAgendamento" styleClass="sched-list" spacing="8">
                        </VBox>
                    </VBox>

                </HBox>
            </VBox>
</VBox>